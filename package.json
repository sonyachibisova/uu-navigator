{
  "name": "bhsad-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Интерактивная 3D-навигация по зданию. Ядро рендера переиспользуется между зданиями.",
  "scripts": {
    "dev": "vite",
    "mobile": "bash scripts/open-mobile.sh",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-data": "tsx scripts/check-data.ts",
    "stats": "tsx scripts/stats.ts",
    "test": "tsx scripts/test-routing.ts && tsx scripts/check-routes.ts",
    "stickers": "tsx scripts/make-stickers.ts",
    "rooms-csv": "tsx scripts/make-rooms-csv.ts"
  },
  "dependencies": {
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.169.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vite": "^5.4.10"
  }
}
